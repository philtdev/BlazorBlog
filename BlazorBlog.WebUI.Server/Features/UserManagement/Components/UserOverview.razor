@page "/user-overview"
@inject ISender Sender
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]


<PageTitle>User Overview</PageTitle>

<div class="space-y-6">

    <h2 class="text-3xl font-extrabold text-gray-50">User Overview</h2>

    @if (users is null)
    {
        <span>Loading users...</span>
    }
    else if (users.Count == 0)
    {
        <span>No users found.</span>
    }
    else
    {
        <QuickGrid Items="users.AsQueryable()">
            <PropertyColumn Property="@(u => u.UserName)" Sortable="true" Title="Username" />
            <PropertyColumn Property="@(u => u.Email)" Sortable="true" Title="Email" />
        </QuickGrid>
    }
</div>

@code {
    private List<UserResponse>? users = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetUsersQuery());

        if (result.Success)
            users = result;
        else
            users = new();
    }
}