@page "/article-overview"
@rendermode @(new InteractiveAutoRenderMode(false))
@inject NavigationManager NavigationManager
@inject IArticlesOverviewService ArticlesOverviewService
@attribute [Authorize]

<PageTitle>Articles Overview</PageTitle>

<h2 class="text-3xl font-extrabold text-gray-50">Articles Overview</h2>

@if (articles is null)
{
    <p>Loading articles...</p>
}
else if (articles.Count == 0)
{
    <p>No articles found.</p>
}
else
{
    <QuickGrid Items="articles.AsQueryable()">
        <PropertyColumn Property="@(a => a.Title)" Sortable="true" />
        <TemplateColumn Title="Published">
            @if (context.IsPublished)
            {
                <span class="text-green-400">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                </span>
            }
            else
            {
                <span class="text-red-400">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </span>
            }
        </TemplateColumn>
        <PropertyColumn Property="@(a => a.DatePublished)" Title="Date Published" Sortable="true" />
        <TemplateColumn>
            <button @onclick="() => EditArticle(context.Id)" class="px-6 py-2 rounded-sm shadow-sm bg-blue-400 text-gray-900 hover:bg-blue-300">Edit</button>
        </TemplateColumn>
        <TemplateColumn>
            <button @onclick="() => TogglePublishArticle(context.Id)" class="px-6 py-2 rounded-sm shadow-sm bg-blue-400 text-gray-900 hover:bg-blue-300">
                @(context.IsPublished ? "Unpublish" : "Publish")
            </button>
        </TemplateColumn>
    </QuickGrid>
}

@code {
    private List<ArticleResponse>? articles;

    protected override async Task OnInitializedAsync()
    {
        articles = await ArticlesOverviewService.GetArticlesByCurrentUserAsync();

        if (articles is null)
            articles = [];
    }

    private async Task TogglePublishArticle(int id)
    {
        var updatedArticle = await ArticlesOverviewService.TogglePublishArticleAsync(id);

        if (updatedArticle is not null && articles is not null)
        {
            var index = articles.FindIndex(a => a.Id == id);

            if (index != -1)
            {
                articles[index] = (ArticleResponse)updatedArticle;

                StateHasChanged();
            }
        }
    }

    private void EditArticle(int id)
    {
        NavigationManager.NavigateTo($"/article-editor/{id}");
    }
}
